{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "openai/gpt-5.4-mini"
    },
    "general": {
      "model": "openai/gpt-5.5"
    },
    "plan": {
      "model": "openai/gpt-5.5"
    },
    "scout": {
      "model": "openai/gpt-5.4-mini"
    }
  },
  "autoupdate": false,
  "default_agent": "plan",
  "model": "openai/gpt-5.5",
  "provider": {
    "ollama": {
      "models": {
        "qwen2.5-coder:3b": {
          "name": "qwen2.5-coder:3b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "small_model": "openai/gpt-5.4-mini"
}
